# Configuration Strapi (même backend que cms-frontend)
STRAPI_TOKEN="VOTRE_TOKEN_STRAPI_ICI"
NUXT_PUBLIC_STRAPI_URL="http://127.0.0.1:1337"
NUXT_PUBLIC_STRAPI_GRAPHQL_URL="http://127.0.0.1:1337/graphql"
NUXT_PUBLIC_SITE_URL="http://localhost:3001"

# SSO CWOWD (optionnel mais recommandé pour le badge Membre CWOWD)
NUXT_PUBLIC_FORUM_URL="https://forum.cwowd.com"
DISCOURSE_SSO_SECRET="SecretDeDev123456789AZERTY"
INTERNAL_NUXT_API_KEY="SecretSuperFortPourNuxtEtStrapi"

# Emails Transactionnels (Brevo gratuit 300/jour ou Amazon SES 0.10$/1000)
# Si vide en développement, les emails sont affichés proprement dans la console serveur
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="votre_login_smtp_brevo"
SMTP_PASS="votre_cle_smtp_brevo"
SMTP_FROM="Ludoccase <noreply@ludoccase.fr>"
